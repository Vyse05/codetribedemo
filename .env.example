# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Target under test ---
# Base URL of the app under test. Used as Playwright's `baseURL`.
# Defaults to the Demo Web Shop if unset (see playwright.config.ts).
BASE_URL=https://demowebshop.tricentis.com

# --- Run behavior (optional) ---
# CI=true                 # enables retries + blob reporter
# TRACE_ENABLED=true      # retain Playwright traces on failure
# RECORDING_ENABLED=true  # retain video on failure; also slows actions to a human pace
# SLOWMO_MS=900           # per-action delay (ms) while recording; default 900
# RUN_ALL_BROWSERS=true   # also run Firefox and WebKit
