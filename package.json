{
  "name": "codetribedemo",
  "version": "1.0.0",
  "description": "Playwright + TypeScript E2E tests for the Tricentis Demo Web Shop",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ci": "CI=true playwright test",
    "lint": "eslint '**/*.ts'",
